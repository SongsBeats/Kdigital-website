# Copy these into Vercel > Project Settings > Environment Variables (never commit real values).
# For local testing only: copy this file to .env (git-ignored, never uploaded) and fill in your own values.

# ---------------------------------------------------------------- Website editor (/admin)
# Required: the password for /admin. At least 10 characters; use a long passphrase.
# Changing it signs everyone out.
ADMIN_PASSWORD=

# Required: secret used to sign the admin session cookie (HMAC-SHA256). At least 32 random characters.
# Generate one with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------- Storage (Vercel Blob)
# You normally do NOT set these by hand. In Vercel > Storage, create a Blob store (access: Public) and
# connect it to this project; Vercel then adds the store credentials to the project automatically
# (BLOB_STORE_ID with OIDC auth on newer stores, or BLOB_READ_WRITE_TOKEN on older ones). Redeploy afterwards.
# Without a Blob store the site still works and shows the built-in content (api/_lib/default-content.json),
# but the editor cannot publish.
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------- AI chat assistant (Google Gemini)
# Required for the chat: Google Gemini API key (Google AI Studio > Get API key). Used only on the server by api/chat.js.
GEMINI_API_KEY=

# Optional: main model. Default: gemini-3.8-flash
GEMINI_MODEL=

# Optional: comma-separated fallback models, tried in order when the main model is busy (429/503),
# unavailable or slow. Default: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_FALLBACK_MODELS=
